# go-at configuration. Copy to ~/.config/go-at.conf (or $XDG_CONFIG_HOME/go-at.conf),
# or point at it with --config FILE or AT_CONFIG=FILE.
# Environment variables (AT_SPOOL etc.) override anything set here.
# Check the result with:  go-at --show-config

# where jobs, logs and history live (default: $XDG_STATE_HOME/at or ~/.local/state/at)
#spool = ~/.local/state/at

# shell that runs jobs
#shell = bash

# let go-at start the daemon when none is running
#autostart = no

# --batch jobs wait until the 1-minute load average is below this (0 = hold them)
#batch_load = 1.5

# days to keep records, logs and saved commands of ended jobs
#keep_days = 30

# keep the commands you typed after a job ends, so "go-at -c JOB" still works
# (the captured environment is never kept)
#keep_commands = yes

# how a job is chosen when a command is given none (only at a terminal):
#   auto  fzf if installed, else a numbered menu (default)   fzf   menu   off
#picker = auto

# the timestamp at the start of every daemon log line and job-log marker:
#   iso   (default)   what "date -Is" prints: 2026-11-20T05:24:26-05:00
# or % sections, as below (plus %:z = -05:00, %s = epoch seconds, %N, %-d = unpadded):
#log_time_format = iso     # a bad value is reported in the daemon log and iso is used
#log_time_format = %F %T %z
#log_time_format = %s

# how times are shown by go-atq and in messages:
#   12h   am/pm (default)     Sun Nov 15 11:15:00 PM 2026
#   24h                       Sun Nov 15 23:15:00 2026
# or a format made of % sections (as in date(1)):
#   %a Sun  %A Sunday  %b Nov  %B November  %d 05  %e " 5"  %m 11  %y 26  %Y 2026
#   %H 23  %k " 3"  %I 11  %l "11"  %M 15  %S 00  %p AM/PM  %P am/pm  %Z EST  %z -0500
#   %F 2026-11-15  %T 23:15:00  %R 23:15  %r 11:15:00 PM  %j day of year  %% a literal %
# For example:
#time_format = %a %b %e %l:%M %p
#time_format = %d.%m.%Y %H:%M
#time_format = 12h
